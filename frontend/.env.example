NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AI_STREAM_URL=http://localhost:8000
# 改完这三个第三方登录变量后必须重启 dev server：CSP 由 next.config.ts 在服务启动时算出，
# 只热更新前端代码会出现「按钮渲染了但脚本被 CSP 挡掉」的半吊子状态。
#
# Google Cloud Console → OAuth client ID（Web application）。留空则 /auth 不渲染 Google 按钮。
# 这个值是公开的；client secret 这条登录流程用不上，不要往前端放。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GitHub → Settings → Developer settings → OAuth Apps。Authorization callback URL 填
# http://localhost:3000/auth/callback/github。client secret 只配在后端，不要放这里。
NEXT_PUBLIC_GITHUB_CLIENT_ID=
