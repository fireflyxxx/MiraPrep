# Copy to .env.prod on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=miraprep-prod
DOMAIN=miraprep.example.com
ACME_EMAIL=ops@example.com

MYSQL_DATABASE=miraprep
MYSQL_USER=miraprep
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
AI_INTERNAL_TOKEN=replace-with-a-different-long-random-internal-token

MINIO_ROOT_USER=miraprep-prod
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET=miraprep

ANTHROPIC_API_KEY=replace-with-your-provider-api-key
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_GRADING_MODEL=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MAX_TOKENS=4096
GRADING_WORKER_COUNT=2
GRADING_MAX_DELIVERY_ATTEMPTS=5

ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
DEEPGRAM_ASR_MODEL=nova-3
DEEPGRAM_ASR_LANGUAGE=zh-CN
DEEPGRAM_ASR_ENDPOINT=wss://api.deepgram.com/v1/listen

TTS_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

MAIL_MODE=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM="MiraPrep <no-reply@example.com>"
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_READ_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
VERIFICATION_SEND_WINDOW=3600
VERIFICATION_SEND_IP_MAX_ATTEMPTS=20
VERIFICATION_SEND_RECIPIENT_MAX_ATTEMPTS=5
VERIFICATION_SEND_GLOBAL_MAX_ATTEMPTS=1000

BACKUP_RETENTION_DAYS=7
