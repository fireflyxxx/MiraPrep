ANTHROPIC_API_KEY=replace-with-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-v4-flash
# 留空时批改与大纲、解析、面试对话统一使用主模型。
ANTHROPIC_GRADING_MODEL=
GRADING_WORKER_COUNT=2
GRADING_MAX_DELIVERY_ATTEMPTS=5
# DeepSeek 的 Anthropic 兼容 API 地址。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MAX_TOKENS=4096
BUSINESS_CALLBACK_URL=http://localhost:8080/api/v1/internal
INTERNAL_TOKEN=replace-with-the-same-internal-token-as-business
REDIS_HOST=localhost
REDIS_PORT=6379
ASR_PROVIDER=not-configured
TTS_PROVIDER=not-configured
CORS_ORIGINS=http://localhost:3000
