ANTHROPIC_API_KEY=replace-with-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-v4-flash
# 留空时批改与大纲、解析、面试对话统一使用主模型。
ANTHROPIC_GRADING_MODEL=
GRADING_WORKER_COUNT=2
GRADING_MAX_DELIVERY_ATTEMPTS=5
# DeepSeek 的 Anthropic 兼容 API 地址。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MAX_TOKENS=4096
BUSINESS_CALLBACK_URL=http://localhost:8080/api/v1/internal
INTERNAL_TOKEN=replace-with-the-same-internal-token-as-business
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ASR_PROVIDER=not-configured
TTS_PROVIDER=not-configured
# T-112: ASR_PROVIDER=deepgram 时必填；输入为 pcm16/16k，默认中文 Nova-3。
DEEPGRAM_API_KEY=
DEEPGRAM_ASR_MODEL=nova-3
DEEPGRAM_ASR_LANGUAGE=zh-CN
DEEPGRAM_ASR_ENDPOINT=wss://api.deepgram.com/v1/listen
# T-113: TTS_PROVIDER=openai 时必填；输出为 pcm16/24k。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
CORS_ORIGINS=http://localhost:3000
